{
    "name": "@scaldwell77/aws-signed-fetch",
    "version": "5.1.1",
    "description": "An implementation of fetch that adds AWS signature headers to the request.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "repository": "https://github.com/stevecaldwell77/aws-signed-fetch-js",
    "scripts": {
        "build": "rimraf dist && tsc",
        "test": "pnpm run build && ava",
        "prepublishOnly": "pnpm run test",
        "prepare": "husky",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write ."
    },
    "keywords": [],
    "license": "MIT",
    "type": "module",
    "prettier": {
        "singleQuote": true,
        "tabWidth": 4
    },
    "devDependencies": {
        "@ava/typescript": "^6.0.0",
        "@aws-sdk/types": "^3.973.1",
        "@eslint/js": "^9.39.2",
        "@types/node": "^25.0.10",
        "ava": "^6.4.1",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.1.0",
        "husky": "^9.1.7",
        "prettier": "^3.8.1",
        "rimraf": "^6.1.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.54.0"
    },
    "lint-staged": {
        "*.js": "eslint --cache --fix",
        "*.{js,css,md}": "prettier --write"
    },
    "engines": {
        "node": ">=18"
    },
    "files": [
        "dist",
        "!**/*.spec.*",
        "CHANGELOG.md",
        "LICENSE",
        "README.md"
    ],
    "peerDependencies": {
        "@aws-crypto/sha256-js": "^5.2.0",
        "@aws-sdk/credential-provider-node": "^3.972.2",
        "@smithy/config-resolver": "^4.4.6",
        "@smithy/node-config-provider": "^4.3.8",
        "@smithy/protocol-http": "^5.3.8",
        "@smithy/signature-v4": "^5.3.8"
    },
    "ava": {
        "typescript": {
            "rewritePaths": {
                "src/": "dist/"
            },
            "compile": false
        }
    }
}
